{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "crons": [
    {
      "path": "/api/cron/payments-reconcile",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/leaderboard-reset",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/bot/webhook",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
