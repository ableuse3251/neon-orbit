{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": {
      "maxDuration": 15,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/payments-reconcile",
      "schedule": "0 1 * * *"
    },
    {
      "path": "/api/cron/notifications",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/leaderboard-reset",
      "schedule": "0 0 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
