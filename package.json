{
  "name": "neon-orbit",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "tsc && vite build && esbuild api/serverless.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=api/index.js",
    "build:serverless": "esbuild api/serverless.ts --bundle --platform=node --target=node20 --format=esm --packages=external --outfile=api/index.js",
    "start": "tsx server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:staging": "vitest run server/__tests__/staging_suite.test.ts",
    "test:smoke": "tsx staging-load-test.ts --mode=smoke",
    "test:load": "tsx staging-load-test.ts --mode=load",
    "audit": "npm audit --audit-level=high --omit=dev",
    "check-all": "npm run typecheck && npm run test && npm run audit",
    "migrate": "tsx server/scripts/run_migrations.ts"
  },
  "engines": {
    "node": ">=20.x"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "animejs": "^4.5.0",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "grammy": "^1.46.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pg": "^8.23.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.7.0",
    "tsx": "^4.21.0",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/animejs": "^4.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "libsodium-wrappers": "^0.8.4",
    "npm-audit-resolver": "^3.0.0-RC.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.3"
  }
}