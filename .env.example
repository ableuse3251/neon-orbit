# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: Hosted domain URL of the Telegram Mini App (e.g. https://neonorbit.app).
APP_URL="https://your-app.up.railway.app"

# PORT & Environment
PORT="3000"
NODE_ENV="production"

# TELEGRAM_BOT_TOKEN: Obtained from @BotFather
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"

# BOT_USERNAME: Telegram Bot handle without @
BOT_USERNAME="NeonOrbitBot"

# ADMIN_TELEGRAM_IDS: Comma-separated list of admin Telegram user IDs (e.g., 123456789,987654321)
ADMIN_TELEGRAM_IDS="123456789,987654321"

# WEBHOOK_SECRET: Secret token for Telegram Bot Webhook authentication
WEBHOOK_SECRET="super_secret_webhook_token_32chars"

# METRICS_SECRET: Dedicated bearer secret for /api/metrics endpoint
METRICS_SECRET="super_secret_metrics_bearer_token"

# JWT_SECRET: Secret for signing internal API tokens
JWT_SECRET="super_secret_jwt_hmac_token"

# DEV_AUTH_BYPASS: Explicit flag for local dev bypass (ONLY active when NODE_ENV !== 'production')
DEV_AUTH_BYPASS="false"

# TELEGRAM_INITDATA_MAX_AGE_SECONDS: Max age allowed for Telegram initData auth_date (default 7200 seconds / 2 hours)
TELEGRAM_INITDATA_MAX_AGE_SECONDS="7200"

# DATABASE_URL: PostgreSQL connection string (Railway, Neon, Supabase, Cloud SQL)
DATABASE_URL="postgresql://postgres:CHANGE_ME_PASSWORD@localhost:5432/neon_orbit"

# PostgreSQL SSL / TLS Certificate Validation
PG_CA_CERT=""
DB_SSL_REJECT_UNAUTHORIZED="true"

# REDIS_URL: Redis Cache for leaderboards & session seeds (Upstash, Railway Redis)
REDIS_URL="redis://:CHANGE_ME_PASSWORD@localhost:6379"

